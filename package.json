{
  "name": "duck-ai-vscode",
  "displayName": "Duck.ai Assistant",
  "description": "AI-powered code completion and generation using Duck.ai's Claude model",
  "version": "0.0.1",
  "publisher": "RamakrishnaM",
  "author": {
    "name": "Duck.ai Contributors"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krishna1993m/duck.ai"
  },
  "keywords": [
    "ai",
    "code-completion",
    "code-generation",
    "duck.ai",
    "claude",
    "ml",
    "assistant"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Duck.ai Assistant",
      "properties": {
        "duckai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "enum": [
            "gpt-4o-mini",
            "gpt-5-mini",
            "gpt-oss-120b",
            "claude-4.5-haiku",
            "meta-llama/Llama-4-Scout",
            "mistralai/Mistral-Small-3-24B",
            "gpt-4o",
            "gpt-5.2",
            "claude-4.5-sonnet",
            "meta-llama/Llama-4-Maverick",
            "claude-4.6-opus"
          ],
          "description": "Select the Duck.ai model to use for completion and generation."
        }
      }
    },
    "commands": [
      {
        "command": "duckai.generateCode",
        "title": "Duck.ai: Generate Code"
      },
      {
        "command": "duckai.debugCode",
        "title": "Duck.ai: Debug Selected Code"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "duckai.debugCode",
          "group": "duckai"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.1.3",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "dependencies": {
    "duckduckgo-chat-interface": "^1.0.0"
  }
}